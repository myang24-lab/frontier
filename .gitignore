# Secrets — never commit. relay/.env holds the Anthropic API key.
.env
*.env
!.env.example

# Ledger database (step 6) — local state, not source.
*.sqlite
*.sqlite-journal
# WAL mode writes these two alongside the database — they hold committed
# ledger rows and must not be tracked either.
*.sqlite-wal
*.sqlite-shm

.DS_Store
