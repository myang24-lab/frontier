# Copy to relay/.env and fill in. Never commit relay/.env — it's gitignored.
#
# Get a key at https://console.anthropic.com — billing must be attached, or every
# call fails. Note claude-fable-5 also requires 30-day data retention: under zero
# data retention it returns a 400 on every request, however valid the payload.
ANTHROPIC_API_KEY=sk-ant-...

# Port the relay listens on. The local bridge (:3001) forwards here.
PORT=8787
